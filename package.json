{
  "name": "@testkaro/testkaro",
  "version": "3.0.0",
  "type": "module",
  "description": "JSON-driven visual test automation - drag-and-drop or write JSON to build Playwright & API tests",
  "license": "MIT",
  "types": "dist/schema/index.d.ts",
  "bin": {
    "testkaro": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts & vite --open",
    "dev:web": "tsx src/server/index.ts & vite --open",
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite --open",
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "postinstall": "node scripts/patch-p-limit.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "appium": "^3.5.2",
    "appium-adb": "^15.0.8",
    "lucide-react": "^1.16.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0",
    "webdriverio": "^9.29.1",
    "ws": "^8.21.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^6.0.3"
  },
  "overrides": {
    "p-limit": "^3.1.0",
    "uuid": "^11.0.0",
    "plist": "^3.1.0",
    "glob": "^10.5.0",
    "archiver": "^7.0.1"
  }
}
